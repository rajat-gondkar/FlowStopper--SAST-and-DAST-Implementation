    "link_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Link Score"
    },
    "reasons": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LinkReason"
