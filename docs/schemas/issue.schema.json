        "payload": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload"
        },
        "proof": {
          "default": "differential",
          "enum": [
            "error",
            "echo",
            "differential",
            "marker",
            "header",
            "redirect",
            "file"
          ],
          "title": "Proof",
          "type": "string"
        },
        "request": {
          "default": "",
          "title": "Request",
          "type": "string"
        },
        "response_excerpt": {
          "default": "",
          "title": "Response Excerpt",
          "type": "string"
        },
        "evidence": {
          "default": "",
          "title": "Evidence",
          "type": "string"
        },
        "repro_curl": {
          "default": "",
          "title": "Repro Curl",
          "type": "string"
        }
      },
      "required": [
        "method",
        "url",
        "path"
      ],
      "title": "RuntimeLocation",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "TaintInfo": {
      "properties": {
        "source_param": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Param"
        },
        "source_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParamLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "call_chain": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Call Chain",
          "type": "array"
        },
        "entry_routes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Entry Routes",
          "type": "array"
        },
        "sanitizers_seen": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Sanitizers Seen",
          "type": "array"
        }
      },
      "title": "TaintInfo",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "cwe": {
      "title": "Cwe",
      "type": "integer"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "label": {
      "$ref": "#/$defs/Label"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "cvss": {
      "title": "Cvss",
      "type": "number"
    },
    "risk": {
      "title": "Risk",
      "type": "number"
