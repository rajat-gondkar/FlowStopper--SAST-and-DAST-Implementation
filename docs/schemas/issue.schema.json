{
  "$defs": {
    "CodeLocation": {
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line_start": {
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "title": "Line End",
          "type": "integer"
        },
        "function": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Function"
        },
        "snippet": {
          "default": "",
          "title": "Snippet",
          "type": "string"
        }
      },
      "required": [
        "file",
        "line_start",
        "line_end"
      ],
      "title": "CodeLocation",
      "type": "object"
    },
    "Engine": {
      "enum": [
        "sast",
        "dast"
      ],
      "title": "Engine",
      "type": "string"
    },
    "Finding": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "engine": {
          "$ref": "#/$defs/Engine"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "cwe": {
          "title": "Cwe",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "taint": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaintInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "suppressed": {
          "default": false,
          "title": "Suppressed",
          "type": "boolean"
        },
        "suppress_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suppress Reason"
        },
        "raw": {
          "additionalProperties": true,
          "default": {},
          "title": "Raw",
          "type": "object"
        }
      },
      "required": [
        "id",
        "engine",
        "tool",
        "rule_id",
        "cwe",
        "title",
        "severity",
        "confidence"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Label": {
      "enum": [
        "confirmed",
        "code_only",
        "runtime_only"
      ],
      "title": "Label",
      "type": "string"
    },
    "LinkReason": {
      "properties": {
        "kind": {
          "enum": [
            "same_cwe",
            "route_chain_origin",
            "route_handler_span",
            "route_reachable",
            "same_param",
            "same_method",
            "auto_verified",
            "ambiguity_penalty"
          ],
          "title": "Kind",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "detail",
        "weight"
      ],
      "title": "LinkReason",
      "type": "object"
    },
    "ParamLocation": {
      "enum": [
        "query",
        "form",
        "json",
        "path",
        "header",
        "cookie"
      ],
      "title": "ParamLocation",
      "type": "string"
    },
    "RuntimeLocation": {
      "properties": {
        "method": {
          "title": "Method",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "route_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
