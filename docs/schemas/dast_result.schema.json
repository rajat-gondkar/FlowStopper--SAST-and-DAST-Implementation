{
  "$defs": {
    "CodeLocation": {
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line_start": {
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "title": "Line End",
          "type": "integer"
        },
        "function": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Function"
        },
        "snippet": {
          "default": "",
          "title": "Snippet",
          "type": "string"
        }
      },
      "required": [
        "file",
        "line_start",
        "line_end"
      ],
      "title": "CodeLocation",
      "type": "object"
    },
    "Engine": {
      "enum": [
        "sast",
        "dast"
      ],
      "title": "Engine",
      "type": "string"
    },
    "Finding": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "engine": {
          "$ref": "#/$defs/Engine"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "cwe": {
          "title": "Cwe",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "taint": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaintInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "suppressed": {
          "default": false,
          "title": "Suppressed",
          "type": "boolean"
        },
        "suppress_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suppress Reason"
        },
        "raw": {
          "additionalProperties": true,
          "default": {},
          "title": "Raw",
          "type": "object"
        }
      },
      "required": [
        "id",
        "engine",
        "tool",
        "rule_id",
        "cwe",
        "title",
        "severity",
        "confidence"
      ],
      "title": "Finding",
      "type": "object"
    },
    "ParamLocation": {
      "enum": [
        "query",
        "form",
        "json",
        "path",
        "header",
        "cookie"
      ],
      "title": "ParamLocation",
      "type": "string"
    },
    "RuntimeLocation": {
      "properties": {
        "method": {
          "title": "Method",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "route_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route Id"
        },
        "param": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Param"
        },
        "param_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParamLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "payload": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload"
        },
        "proof": {
          "default": "differential",
          "enum": [
            "error",
            "echo",
            "differential",
            "marker",
            "header",
            "redirect",
            "file"
          ],
          "title": "Proof",
          "type": "string"
        },
        "request": {
          "default": "",
          "title": "Request",
          "type": "string"
        },
        "response_excerpt": {
          "default": "",
          "title": "Response Excerpt",
          "type": "string"
        },
        "evidence": {
          "default": "",
          "title": "Evidence",
          "type": "string"
        },
        "repro_curl": {
          "default": "",
          "title": "Repro Curl",
          "type": "string"
        }
      },
      "required": [
        "method",
        "url",
        "path"
      ],
      "title": "RuntimeLocation",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "TaintInfo": {
      "properties": {
        "source_param": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Param"
        },
        "source_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParamLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "call_chain": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Call Chain",
          "type": "array"
        },
        "entry_routes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Entry Routes",
          "type": "array"
        },
        "sanitizers_seen": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Sanitizers Seen",
          "type": "array"
        }
      },
      "title": "TaintInfo",
      "type": "object"
    }
  },
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "stats": {
      "additionalProperties": true,
      "default": {},
      "title": "Stats",
      "type": "object"
    }
  },
  "required": [
    "findings"
  ],
  "title": "DastResult",
  "type": "object"
}
